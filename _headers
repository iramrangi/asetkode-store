  ! Content-Security-Policy
  Content-Security-Policy: frame-ancestors 'self' https://asetkode.blogspot.com; object-src 'none'; base-uri 'self'; upgrade-insecure-requests

/free/apps/*
  ! X-Frame-Options
  ! Content-Security-Policy
  Content-Security-Policy: frame-ancestors 'self' https://asetkode.blogspot.com; object-src 'none'; base-uri 'self'; upgrade-insecure-requests

