  Permissions-Policy: camera=(), microphone=(), geolocation=(), payment=(), usb=()
  Content-Security-Policy: default-src 'self'; base-uri 'self'; object-src 'none'; form-action 'self' https://buy.polar.sh https://polar.sh https://web.mayar.id; script-src 'self' https://asetkode.blogspot.com https://script.google.com; style-src 'self' 'unsafe-inline' https://fonts.googleapis.com; font-src 'self' https://fonts.gstatic.com data:; img-src 'self' https: data:; connect-src 'self' https://script.google.com https://script.googleusercontent.com https://asetkode.blogspot.com; frame-src 'self' https://buy.polar.sh https://polar.sh https://*.mayar.id; frame-ancestors 'self'; upgrade-insecure-requests

/demo/*
